# --- Window Actions ---
rctrl + shift - q : yabai -m window --close
alt + shift - q   : yabai -m window --close

rctrl + shift - f : yabai -m window --toggle native-fullscreen
alt + shift - f   : yabai -m window --toggle native-fullscreen

rctrl - space : yabai -m window --toggle float
alt - space   : yabai -m window --toggle float

# --- Move between spaces (creates the space if it doesn't exist yet) ---
rctrl - 1 : ~/dotfiles/yabai/scripts/space.sh 1 focus
alt - 1   : ~/dotfiles/yabai/scripts/space.sh 1 focus

rctrl - 2 : ~/dotfiles/yabai/scripts/space.sh 2 focus
alt - 2   : ~/dotfiles/yabai/scripts/space.sh 2 focus

rctrl - 3 : ~/dotfiles/yabai/scripts/space.sh 3 focus
alt - 3   : ~/dotfiles/yabai/scripts/space.sh 3 focus

rctrl - 4 : ~/dotfiles/yabai/scripts/space.sh 4 focus
alt - 4   : ~/dotfiles/yabai/scripts/space.sh 4 focus

rctrl - 5 : ~/dotfiles/yabai/scripts/space.sh 5 focus
alt - 5   : ~/dotfiles/yabai/scripts/space.sh 5 focus

rctrl - 6 : ~/dotfiles/yabai/scripts/space.sh 6 focus
alt - 6   : ~/dotfiles/yabai/scripts/space.sh 6 focus

rctrl - 7 : ~/dotfiles/yabai/scripts/space.sh 7 focus
alt - 7   : ~/dotfiles/yabai/scripts/space.sh 7 focus

rctrl - 8 : ~/dotfiles/yabai/scripts/space.sh 8 focus
alt - 8   : ~/dotfiles/yabai/scripts/space.sh 8 focus

rctrl - 9 : ~/dotfiles/yabai/scripts/space.sh 9 focus
alt - 9   : ~/dotfiles/yabai/scripts/space.sh 9 focus

# --- Open Apps ---
rctrl + shift - g : open -a "Ghostty"
alt + shift - g   : open -a "Ghostty"

rctrl + shift - z : open -a "Zen"
alt + shift - z   : open -a "Zen"

rctrl + shift - c : open -a "Cinny"
alt + shift - c   : open -a "Cinny"

rctrl + shift - s : open -a "Signal"
alt + shift - s   : open -a "Signal"

rctrl + shift - d : open -a "Vesktop"
alt + shift - d   : open -a "Vesktop"

rctrl + shift - t : open -a "Telegram"
alt + shift - t   : open -a "Telegram"

rctrl + shift - p : open -a "Spotify"
alt + shift - p   : open -a "Spotify"

rctrl + shift - e : open -a "Element"
alt + shift - e   : open -a "Element"

# --- Send focused window to space and follow (creates the space if missing) ---
rctrl + shift - 1 : ~/dotfiles/yabai/scripts/space.sh 1 send
alt + shift - 1   : ~/dotfiles/yabai/scripts/space.sh 1 send

rctrl + shift - 2 : ~/dotfiles/yabai/scripts/space.sh 2 send
alt + shift - 2   : ~/dotfiles/yabai/scripts/space.sh 2 send

rctrl + shift - 3 : ~/dotfiles/yabai/scripts/space.sh 3 send
alt + shift - 3   : ~/dotfiles/yabai/scripts/space.sh 3 send

rctrl + shift - 4 : ~/dotfiles/yabai/scripts/space.sh 4 send
alt + shift - 4   : ~/dotfiles/yabai/scripts/space.sh 4 send

rctrl + shift - 5 : ~/dotfiles/yabai/scripts/space.sh 5 send
alt + shift - 5   : ~/dotfiles/yabai/scripts/space.sh 5 send

rctrl + shift - 6 : ~/dotfiles/yabai/scripts/space.sh 6 send
alt + shift - 6   : ~/dotfiles/yabai/scripts/space.sh 6 send

rctrl + shift - 7 : ~/dotfiles/yabai/scripts/space.sh 7 send
alt + shift - 7   : ~/dotfiles/yabai/scripts/space.sh 7 send

rctrl + shift - 8 : ~/dotfiles/yabai/scripts/space.sh 8 send
alt + shift - 8   : ~/dotfiles/yabai/scripts/space.sh 8 send

rctrl + shift - 9 : ~/dotfiles/yabai/scripts/space.sh 9 send
alt + shift - 9   : ~/dotfiles/yabai/scripts/space.sh 9 send

# --- Swap window in direction (WASD) ---
rctrl + cmd - a : yabai -m window --swap west
alt + cmd - a   : yabai -m window --swap west

rctrl + cmd - s : yabai -m window --swap south
alt + cmd - s   : yabai -m window --swap south

rctrl + cmd - w : yabai -m window --swap north
alt + cmd - w   : yabai -m window --swap north

rctrl + cmd - d : yabai -m window --swap east
alt + cmd - d   : yabai -m window --swap east

# --- Warp window in direction (reflow into tree, HJKL) ---
rctrl + cmd - h : yabai -m window --warp west
alt + cmd - h   : yabai -m window --warp west

rctrl + cmd - j : yabai -m window --warp south
alt + cmd - j   : yabai -m window --warp south

rctrl + cmd - k : yabai -m window --warp north
alt + cmd - k   : yabai -m window --warp north

rctrl + cmd - l : yabai -m window --warp east
alt + cmd - l   : yabai -m window --warp east

# --- Resize (grow/shrink east edge, WASD-ish) ---
rctrl + shift - h : yabai -m window --resize left:-40:0
alt + shift - h   : yabai -m window --resize left:-40:0

rctrl + shift - l : yabai -m window --resize left:40:0
alt + shift - l   : yabai -m window --resize left:40:0

rctrl + shift - k : yabai -m window --resize bottom:0:-40
alt + shift - k   : yabai -m window --resize bottom:0:-40

rctrl + shift - j : yabai -m window --resize bottom:0:40
alt + shift - j   : yabai -m window --resize bottom:0:40

# --- Balance / rotate layout ---
rctrl - e : yabai -m space --balance
alt - e   : yabai -m space --balance

rctrl - r : yabai -m space --rotate 90
alt - r   : yabai -m space --rotate 90

# --- Slack ---
rctrl + shift - m : open -a "Slack"
alt + shift - m   : open -a "Slack"

# --- Window Focus (Vim-ish HJKL or WASD) ---
rctrl - a : yabai -m window --focus west
alt - a   : yabai -m window --focus west

rctrl - s : yabai -m window --focus south
alt - s   : yabai -m window --focus south

rctrl - w : yabai -m window --focus north
alt - w   : yabai -m window --focus north

rctrl - d : yabai -m window --focus east
alt - d   : yabai -m window --focus east
